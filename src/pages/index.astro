---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopStrip from '../components/TopStrip.astro';
import Masthead from '../components/masthead/Masthead.astro';
import Lead from '../components/blocks/Lead.astro';
import DailyPrompt from '../components/blocks/DailyPrompt.astro';
import DailyExponential from '../components/blocks/DailyExponential.astro';
import FromX from '../components/blocks/FromX.astro';
import HackerNews from '../components/blocks/HackerNews.astro';
import Interview from '../components/blocks/Interview.astro';
import Interactive from '../components/blocks/Interactive.astro';
import Artworks from '../components/blocks/Artworks.astro';
import Briefs from '../components/blocks/Briefs.astro';
import Quotes from '../components/blocks/Quotes.astro';
import Pager from '../components/Pager.astro';
import Popups from '../components/Popups.astro';

const issues = await getCollection('issues');
const issue = issues.sort((a, b) => b.data.number - a.data.number)[0];
if (!issue) throw new Error('No issues in /issues');

const d = issue.data;
const { Content } = await render(issue);
---

<Base title={`${d.lead.headline}. The Singularity Times`} description={d.lead.deck} image={d.lead.art?.src}>
  <TopStrip />
  <Masthead coins={d.coins} predictions={d.predictions} />

  <main class="front">
    <div class="top">
      <div class="col main">
        <Lead {...d.lead}><Content /></Lead>
      </div>
      <aside class="col side">
        <DailyPrompt text={d.prompt.text} />
        {d.exponential && <DailyExponential {...d.exponential} />}
      </aside>
    </div>

    <!-- Everything else is set like type: one three-column flow that balances its own column bottoms. -->
    <div class="flow">
      {d.briefs.length > 0 && <Briefs items={d.briefs} />}
      {d.fromX.length > 0 && <FromX posts={d.fromX} />}
      {d.quotes.length > 0 && <Quotes items={d.quotes} />}
      {d.interview && <Interview {...d.interview} />}
      {d.interactive && <Interactive {...d.interactive} />}
      {d.hackerNews.length > 0 && <HackerNews items={d.hackerNews} />}
      {d.artworks.length > 0 && <Artworks items={d.artworks} />}
    </div>
  </main>

  <Pager page={1} pages={d.pages} />
  <Popups slot="overlay" number={d.number} prompt={d.prompt.text} />
</Base>

<style>
  .front { margin-top: 12px; }
  .top { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); padding-bottom: 14px; border-bottom: 1px solid var(--ink); }
  .col { min-width: 0; }
  .main { padding-right: 14px; }
  /* The sidebar matches the lead's height; the exponential chart takes up whatever is left. */
  .side { display: flex; flex-direction: column; padding-left: 14px; border-left: 1px solid var(--hair); }
  .side > :global(section + section) { border-top: 1px solid var(--hair); margin-top: 12px; padding-top: 12px; }
  .flow { columns: 3; column-gap: 28px; column-rule: 1px solid var(--hair); padding-top: 12px; }
  .flow > :global(* + *) { border-top: 1px solid var(--ink); margin-top: 12px; padding-top: 12px; }
  .flow :global(.sect), .flow :global(h3) { break-after: avoid; }
  .flow :global(li), .flow :global(figure), .flow :global(.media) { break-inside: avoid; }
  @media (max-width: 980px) {
    .top { grid-template-columns: 1fr; }
    .main { padding-right: 0; }
    .side { padding-left: 0; border-left: 0; border-top: 1px solid var(--hair); margin-top: 12px; padding-top: 12px; }
    .flow { columns: 1; }
  }
</style>

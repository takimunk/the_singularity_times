---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopStrip from '../components/TopStrip.astro';
import Masthead from '../components/masthead/Masthead.astro';
import Lead from '../components/blocks/Lead.astro';
import DailyPrompt from '../components/blocks/DailyPrompt.astro';
import DailyExponential from '../components/blocks/DailyExponential.astro';
import FromX from '../components/blocks/FromX.astro';
import HackerNews from '../components/blocks/HackerNews.astro';
import Interview from '../components/blocks/Interview.astro';
import Interactive from '../components/blocks/Interactive.astro';
import Artworks from '../components/blocks/Artworks.astro';
import Briefs from '../components/blocks/Briefs.astro';
import Quotes from '../components/blocks/Quotes.astro';
import Pager from '../components/Pager.astro';
import Popups from '../components/Popups.astro';

const issues = await getCollection('issues');
const issue = issues.sort((a, b) => b.data.number - a.data.number)[0];
if (!issue) throw new Error('No issues in /issues');

const d = issue.data;
const { Content } = await render(issue);
---

<Base title={`${d.lead.headline}. The Singularity Times`} description={d.lead.deck} image={d.lead.art?.src}>
  <TopStrip />
  <Masthead coins={d.coins} predictions={d.predictions} />

  <main class="front">
    <div class="row">
      <div class="col c8">
        <Lead {...d.lead}><Content /></Lead>
      </div>
      <div class="col c4 stack">
        <DailyPrompt text={d.prompt.text} />
        {d.exponential && <DailyExponential {...d.exponential} />}
      </div>
    </div>

    <div class="row">
      {d.briefs.length > 0 && <div class="col c4"><Briefs items={d.briefs} /></div>}
      {d.fromX.length > 0 && <div class="col c4"><FromX posts={d.fromX} /></div>}
      {d.quotes.length > 0 && <div class="col c4"><Quotes items={d.quotes} /></div>}
    </div>

    <div class="row">
      {d.interactive && <div class="col c8"><Interactive {...d.interactive} /></div>}
      {d.interview && <div class="col c4"><Interview {...d.interview} /></div>}
    </div>

    <div class="row">
      {d.hackerNews.length > 0 && <div class="col c4"><HackerNews items={d.hackerNews} /></div>}
      {d.artworks.length > 0 && <div class="col c8"><Artworks items={d.artworks} /></div>}
    </div>
  </main>

  <Pager page={1} pages={d.pages} />
  <Popups slot="overlay" number={d.number} prompt={d.prompt.text} />
</Base>

<style>
  .front { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); margin-top: 12px; }
  .row { display: grid; grid-template-columns: subgrid; grid-column: 1 / -1; padding: 12px 0 14px; border-bottom: 1px solid var(--ink); }
  .row:first-child { padding-top: 0; }
  .row:empty { display: none; }
  .col { min-width: 0; padding: 0 14px; border-left: 1px solid var(--hair); }
  .col:first-child { padding-left: 0; border-left: 0; }
  .col:last-child { padding-right: 0; }
  .c8 { grid-column: span 8; }
  .c6 { grid-column: span 6; }
  .c4 { grid-column: span 4; }
  .stack > :global(section + section) { border-top: 1px solid var(--hair); margin-top: 12px; padding-top: 12px; }
  @media (max-width: 980px) {
    .c8, .c6, .c4 { grid-column: 1 / -1; }
    .row { grid-template-columns: 1fr; }
    .col { padding: 0; border-left: 0; }
    .col + .col { border-top: 1px solid var(--hair); margin-top: 12px; padding-top: 12px; }
  }
</style>

---
// Posts from X, set in the paper's own type: author, words, date and a snapshot of the counts, with a link back.
// No X widgets and no avatars: nothing of the author's is re-uploaded, and the page makes no request to X.
import Icon from '../Icon.astro';

interface Props {
  posts: { url: string; author: string; handle: string; text: string; date?: Date; likes?: number; reposts?: number; replies?: number }[];
}

const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const num = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const counts = (p: Props['posts'][number]) =>
  (
    [
      [p.replies, 'replies'],
      [p.reposts, 'reposts'],
      [p.likes, 'likes'],
    ] as const
  ).filter(([n]) => n !== undefined) as [number, string][];
---

<section>
  <div class="sect"><Icon name="x" /> From X</div>
  {posts.map((post) => (
    <figure class="post">
      <figcaption class="who">
        <b>{post.author}</b>
        <a class="h" href={post.url} target="_blank" rel="noopener">{post.handle}</a>
      </figcaption>
      <blockquote cite={post.url}>{post.text}</blockquote>
      <div class="foot">
        {counts(post).length > 0 && (
          <span class="n">
            {counts(post).map(([n, label]) => (
              <span title={`${n.toLocaleString('en-US')} ${label}`}>{num.format(n)} <i>{label}</i></span>
            ))}
          </span>
        )}
        <span class="meta">
          {post.date && <>{fmt.format(post.date)}. </>}
          <a href={post.url} target="_blank" rel="noopener">View on X</a>
        </span>
      </div>
    </figure>
  ))}
</section>

<style>
  .post { padding: 8px 0; break-inside: avoid; }
  .post:first-of-type { padding-top: 0; }
  .post + .post { border-top: 1px dotted var(--hair); }
  .who { display: flex; align-items: baseline; gap: 6px; margin-bottom: 3px; }
  .who b { font: 700 14px/1.2 var(--f-body); }
  .h { font: 400 11px/1.2 var(--f-mono); color: var(--ink-soft); text-decoration: none; }
  .h:hover { text-decoration: underline; }
  blockquote { margin: 0 0 5px; padding-left: 10px; border-left: 2px solid var(--ink); font: 400 16px/1.35 var(--f-body); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 10px; align-items: baseline; }
  .n { display: flex; gap: 10px; font: 500 11px/1.3 var(--f-mono); }
  .n i { font: italic 400 12px/1 var(--f-body); color: var(--ink-soft); }
</style>

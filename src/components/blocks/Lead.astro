---
interface Props {
  headline: string;
  deck: string;
  byline?: string;
  art?: { src: string; alt: string; caption?: string; width?: number; height?: number };
  viz?: { id: string; credit: string; url: string };
  sources?: { name: string; url: string }[];
  placeholder?: boolean;
}

const { headline, deck, byline, art, viz, sources = [], placeholder } = Astro.props;
---

<article class="lead">
  <div class="sect">Front page{placeholder && <span class="note">placeholder</span>}</div>
  {viz ? (
    <figure class="media cover viz" data-viz={viz.id}>
      <canvas aria-label="A cloud deck at dusk, live shader"></canvas>
      <a class="cap" href={viz.url} target="_blank" rel="noopener">{viz.credit}</a>
    </figure>
  ) : (
    <figure class="media cover">
      {art ? (
        <img src={art.src} alt={art.alt} width={art.width} height={art.height} loading="eager" fetchpriority="high" decoding="async" />
      ) : (
        <span class="hatch" aria-hidden="true"></span>
      )}
      <figcaption class="cap">{art?.caption ?? 'Cover art by Dima. Image or video goes here'}</figcaption>
    </figure>
  )}
  <h2>{headline}</h2>
  <p class="deck">{deck}</p>
  <div class="body"><slot /></div>
  {(byline || sources.length > 0) && (
    <div class="byl">
      {byline}{byline && sources.length > 0 && '. '}
      {sources.length > 0 && (
        <>
          Sources:{' '}
          {sources.map((s, i) => (
            <>{i > 0 && ', '}<a href={s.url} target="_blank" rel="noopener">{s.name}</a></>
          ))}
        </>
      )}
    </div>
  )}
</article>

<style>
  .cover { aspect-ratio: 3 / 1; }
  .hatch {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(0deg, var(--earth) 0 1.2px, transparent 1.2px 5px);
    opacity: 0.55;
  }
  /* Dusk gradient shown before the shader starts, or instead of it without WebGL2. */
  .viz { background: linear-gradient(180deg, #14295e 0%, #5f7fc4 55%, #e0743a 78%, #44425f 100%); }
  .viz .cap { right: 0; left: auto; text-decoration: none; }
  .viz .cap:hover { text-decoration: underline; }
  h2 { font: 800 clamp(24px, 3vw, 36px)/1.04 var(--f-body); letter-spacing: -0.01em; margin: 10px 0 4px; }
  .deck { font: italic 400 16px/1.35 var(--f-body); color: var(--ink-soft); margin: 0 0 8px; max-width: 62ch; }
  .body { columns: 2 220px; column-gap: 20px; column-rule: 1px solid var(--hair); hyphens: auto; }
  .body :global(p) { margin: 0 0 0.6em; }
</style>

<script>
  import { startClouds } from '../../viz/clouds';

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.viz[data-viz="clouds"] canvas')) {
    startClouds(canvas);
  }
</script>

---
interface Props {
  title: string;
  series: [number, number][];
  unit?: string;
  caption?: string;
  source: string;
  sourceUrl?: string;
  draft?: boolean;
}

const { title, series, unit, caption, source, sourceUrl, draft } = Astro.props;

// Least-squares fit of ln(y) on x, done at build time.
const xs = series.map(([x]) => x - series[0][0]);
const ys = series.map(([, y]) => Math.log(y));
const n = series.length;
const mx = xs.reduce((a, b) => a + b) / n;
const my = ys.reduce((a, b) => a + b) / n;
const b = xs.reduce((s, x, i) => s + (x - mx) * (ys[i] - my), 0) / xs.reduce((s, x) => s + (x - mx) ** 2, 0);
const a = my - b * mx;
const rate = Math.round((Math.exp(b) - 1) * 100);
const years = Math.log(2) / b;
const doubling = years < 2 ? `${Math.round(years * 12)} months` : `${years.toFixed(1)} years`;
const first = Math.floor(series[0][0]);
const last = Math.floor(series[n - 1][0]);
---

<section id="exp">
  <div class="sect">Daily Exponential{draft && <span class="note">draft data</span>}</div>
  <h3>{title}</h3>
  <canvas
    id="exp-chart"
    data-series={JSON.stringify(series)}
    data-fit={JSON.stringify([a, b])}
    data-unit={unit}
    role="img"
    aria-label={`Bar chart of ${title.toLowerCase()}, ${first} to ${last}, with an exponential fit`}
  ></canvas>
  {caption && <p class="cap">{caption}</p>}
  <p class="meta">
    Exponential fit: {rate < 100 && <>about +{rate}% a year, </>}doubling every {doubling}. Source:{' '}
    {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noopener">{source}</a> : source}.
  </p>
</section>

<style>
  h3 { margin-top: 0; }
  .cap { margin: 4px 0 2px; }
  canvas { width: 100%; height: 190px; }
</style>

<script>
  import { fit, onRelayout, palette, DPR } from '../../lib/canvas';

  const cv = document.getElementById('exp-chart') as HTMLCanvasElement | null;
  if (cv) {
    const series: [number, number][] = JSON.parse(cv.dataset.series!);
    const [a, b]: [number, number] = JSON.parse(cv.dataset.fit!);
    const fitY = (x: number) => Math.exp(a + b * x);

    const draw = () => {
      const p = palette();
      const [w, h] = fit(cv);
      const c = cv.getContext('2d')!;
      c.setTransform(DPR, 0, 0, DPR, 0, 0);
      c.clearRect(0, 0, w, h);
      const n = series.length;
      const x0 = series[0][0], x1 = series[n - 1][0], span = x1 - x0;
      const unit = cv.dataset.unit;
      const peak = Math.max(...series.map(([, v]) => v));
      const step = 10 ** Math.floor(Math.log10(peak)) / 2;
      const max = Math.ceil((peak * 1.05) / step) * step;
      const L = 34, B = h - 18, T = 8, R = w - 4;
      // Equal spacing gives the old bar width; uneven dates shrink bars to fit the closest pair.
      const slot = (R - L) / n;
      const X = (x: number) => L + slot / 2 + ((x - x0) / span) * (R - L - slot);
      const gap = Math.min(...series.slice(1).map(([x], i) => X(x) - X(series[i][0])));
      const ww = Math.max(3, Math.min(slot * 0.64, gap * 0.7));
      const Y = (v: number) => B - ((B - T) * v) / max;
      const label = (v: number) => (v >= 1000 ? `${v / 1000}k` : String(v));

      c.font = `400 10px ${p.mono}`;
      c.fillStyle = p.soft;
      c.textAlign = 'right';
      c.strokeStyle = p.hair;
      c.lineWidth = 0.5;
      for (const v of [0, max / 2, max]) {
        const y = Y(v);
        c.beginPath(); c.moveTo(L, y); c.lineTo(R, y); c.stroke();
        c.fillText(label(v), L - 5, y + 3);
      }
      if (unit) { c.textAlign = 'left'; c.fillText(unit, L + 3, T + 11); }
      for (const [xv, v] of series) {
        const x = X(xv) - ww / 2, y = Y(v);
        c.save();
        c.beginPath(); c.rect(x, y, ww, B - y); c.clip();
        c.strokeStyle = p.ink; c.lineWidth = 0.6;
        for (let yy = B; yy > y - 2; yy -= 2.4) { c.beginPath(); c.moveTo(x, yy); c.lineTo(x + ww, yy); c.stroke(); }
        c.restore();
        c.strokeStyle = p.ink; c.lineWidth = 0.9; c.strokeRect(x, y, ww, B - y);
      }
      // Year labels on whole years, every third one on long spans.
      c.fillStyle = p.soft; c.textAlign = 'center';
      const every = span > 6 ? 3 : 1;
      for (let yr = Math.ceil(x0); yr <= Math.floor(x1); yr++) {
        if ((yr - Math.ceil(x0)) % every === 0 || yr === Math.floor(x1)) c.fillText(String(yr), X(yr), B + 12);
      }
      c.save();
      c.beginPath(); c.rect(L, 0, R - L, B); c.clip();
      c.beginPath();
      for (let i = 0; i <= 90; i++) {
        const xx = (i / 90) * span;
        const x = X(x0 + xx), y = Y(fitY(xx));
        i ? c.lineTo(x, y) : c.moveTo(x, y);
      }
      c.strokeStyle = p.earth; c.lineWidth = 1.8; c.stroke();
      c.restore();
      c.strokeStyle = p.ink; c.lineWidth = 1;
      c.beginPath(); c.moveTo(L, B); c.lineTo(R, B); c.stroke();
    };

    draw();
    onRelayout(draw);
  }
</script>

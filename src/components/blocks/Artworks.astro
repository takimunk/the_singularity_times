---
interface Props {
  items: { title: string; author: string; url: string; image?: string }[];
}

const { items } = Astro.props;
---

<section>
  <div class="sect">Artworks</div>
  <div class="arts">
    {items.map((it, i) => (
      <figure>
        <a class="media" href={it.url} target="_blank" rel="noopener">
          {it.image ? <img src={it.image} alt={`${it.title} by ${it.author}`} loading="lazy" decoding="async" /> : <span class={`hatch h${i % 2}`} aria-hidden="true"></span>}
        </a>
        <figcaption>{it.title} <span>by {it.author}</span></figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .arts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .media { display: block; aspect-ratio: 4 / 3; }
  .hatch { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, var(--earth) 0 1px, transparent 1px 4px); opacity: 0.5; }
  .hatch.h1 { background: repeating-linear-gradient(90deg, var(--ink) 0 1px, transparent 1px 4px); opacity: 0.35; }
  figcaption { font: 400 12px/1.3 var(--f-body); margin-top: 4px; }
  figcaption span { color: var(--ink-soft); font-style: italic; }
</style>

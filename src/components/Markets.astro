---
// Balthasar: Polymarket widgets in place of the stock-market table.
// Each market is a plain link (the static fallback) plus Polymarket's own iframe
// embed (embed.polymarket.com/market.html), which a small script points at the
// slug in the reader's theme; the iframe itself is native-lazy.
interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
// "will-agi-arrive-by-2030" -> "Will agi arrive by 2030": a readable label until the widget loads.
const label = (slug: string) => {
  const text = slug.replace(/-/g, ' ');
  return text.charAt(0).toUpperCase() + text.slice(1);
};
---

<section class="markets">
  <h3 class="section-title">Рынки предсказаний</h3>
  {
    slugs.length === 0 ? (
      <p class="empty">Рынки появятся в выпуске.</p>
    ) : (
      <ol class="list">
        {slugs.map((slug) => (
          <li>
            <a class="market" href={`https://polymarket.com/event/${encodeURIComponent(slug)}`} target="_blank" rel="noopener">
              {label(slug)}
            </a>
            <iframe
              class="embed"
              title={`Polymarket: ${label(slug)}`}
              data-slug={slug}
              width="400"
              height="180"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              hidden
            />
          </li>
        ))}
      </ol>
    )
  }
  {slugs.length > 0 && <p class="kicker source">Котировки: Polymarket</p>}
</section>

<style>
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .list li:last-child { border-bottom: 0; }
  .market { font-family: var(--font-headline); font-size: 1.0625rem; line-height: 1.3; text-decoration: none; }
  .market:hover { text-decoration: underline; }
  .embed { width: 100%; max-width: 400px; height: 180px; border: 0; margin-top: 8px; }
  .embed[hidden] { display: none; }
  .empty { font-style: italic; color: var(--ink-muted); margin: 0; }
  .source { margin-top: 12px; }
</style>

<script>
  const theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('.markets iframe[data-slug]')) {
    const params = new URLSearchParams({ market: frame.dataset.slug ?? '', features: 'volume', theme });
    frame.src = `https://embed.polymarket.com/market.html?${params}`;
    frame.hidden = false;
  }
</script>

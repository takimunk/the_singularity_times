---
// Balthasar: the reader prompt and last issue's best answers.
// Answers come in as replies in X; no forms, no backend.
interface Props {
  question: string;
  replyUrl?: string;
  lastAnswers: { author: string; text: string; url: string }[];
}

const { question, replyUrl, lastAnswers } = Astro.props;
---

<section class="daily-prompt">
  <h3 class="section-title">Вопрос номера</h3>
  <p class="question">{question}</p>
  {
    replyUrl && (
      <a class="reply" href={replyUrl} target="_blank" rel="noopener">
        Ответить в X →
      </a>
    )
  }
  {
    lastAnswers.length > 0 && (
      <>
        <h4 class="kicker answers-title">Лучшие ответы на прошлый вопрос</h4>
        <ol class="answers">
          {lastAnswers.map((answer) => (
            <li>
              <blockquote cite={answer.url}>
                <p>«{answer.text}»</p>
              </blockquote>
              <a class="author" href={answer.url} target="_blank" rel="noopener">
                — {answer.author}
              </a>
            </li>
          ))}
        </ol>
      </>
    )
  }
</section>

<style>
  .daily-prompt { margin-top: 32px; }
  .question {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.2;
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .reply {
    font-family: var(--font-meta);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .answers-title { margin-top: 24px; padding-top: 8px; border-top: 3px double var(--rule); }
  .answers { list-style: none; margin: 0; padding: 0; }
  .answers li + li { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--rule); }
  blockquote { margin: 0 0 4px; }
  blockquote p { margin: 0; }
  .author { font-family: var(--font-meta); font-size: 0.8125rem; color: var(--ink-muted); }
</style>
